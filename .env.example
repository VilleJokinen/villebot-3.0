# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Control panel. Set PANEL_HOST to your Tailscale IP to reach it from your phone.
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
# Panel logins. One entry per person: name:token, comma-separated. Each token is a long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Remove someone's entry and restart to revoke their access.
PANEL_USERS=ville:CHANGE_ME_TO_A_RANDOM_TOKEN
# Optional shorthand for a single login named "owner" (can be combined with PANEL_USERS).
PANEL_TOKEN=
