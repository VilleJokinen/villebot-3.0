# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Control panel. Set PANEL_HOST to your Tailscale IP to reach it from your phone.
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"`
PANEL_TOKEN=
