# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
CLIENT_ID=

# Control panel. Keep PANEL_HOST=127.0.0.1; the Cloudflare Tunnel proxies the public URL to it.
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
# Panel logins. Set at least one.
# One line per server: PANEL_PASSWORD_<serverId>=... (8+ characters) unlocks only that server, and
# /link in that server shows it.
# PANEL_PASSWORD_123456789012345678=
# Owner password (8+ characters): unlocks every server. /link never shows it.
PANEL_PASSWORD=
# Personal logins that unlock every server, one per person: name:token, comma-separated. Tokens are
# 16+ characters, e.g. node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Give each person https://<panel>/?token=<their token>. Remove an entry and restart to revoke it.
PANEL_USERS=
# Optional: a token login named "owner" (16+ characters), like PANEL_PASSWORD.
PANEL_TOKEN=
# Public panel address that /link sends: your Cloudflare Tunnel hostname, e.g. https://villebot.example.com
PANEL_URL=
